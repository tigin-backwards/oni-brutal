<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- This project's TextMeshPro: replaces the Unity.TextMeshPro package the game ships (PLAN M9). The
         types and serialized fields in Generated/ come from the shipped package's metadata
         (scripts/regen-packages.sh); everything else is written from docs/cleanroom. -->
    <AssemblyName>Unity.TextMeshPro</AssemblyName>
    <RootNamespace>TMPro</RootNamespace>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS0108;CS0114;CS0660;CS0661;CS8981;CS0649;CS0169;CS0414</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../OniBrutal.UnityEngine/OniBrutal.UnityEngine.csproj" />
    <ProjectReference Include="../UnityEngine.UI/UnityEngine.UI.csproj" />
  </ItemGroup>

</Project>
