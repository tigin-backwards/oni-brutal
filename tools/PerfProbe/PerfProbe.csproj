<Project Sdk="Microsoft.NET.Sdk">
  <!-- A game mod (KMod) that loads in both players: see Probe.cs. OniManaged is the game's
       Managed folder (default: the Linux install at ~/projects/oni-linux). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <OniManaged Condition="'$(OniManaged)' == ''">$(HOME)/projects/oni-linux/OxygenNotIncluded_Data/Managed</OniManaged>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(OniManaged)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(OniManaged)/UnityEngine.dll" Private="false" />
    <Reference Include="$(OniManaged)/UnityEngine.ScreenCaptureModule.dll" Private="false" />
    <Reference Include="$(OniManaged)/UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(OniManaged)/UnityEngine.AssetBundleModule.dll" Private="false" />
    <Reference Include="$(OniManaged)/UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="$(OniManaged)/UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(OniManaged)/UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(OniManaged)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(OniManaged)/Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="$(OniManaged)/0Harmony.dll" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <None Include="mod.yaml;mod_info.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
